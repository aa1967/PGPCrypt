#!/bin/sh
# Application-state/network isolation, not protection against a hostile host.
set -eu
if [ "$#" -ne 0 ]; then echo "Launch with: pgpcrypt (no arguments)." >&2; exit 2; fi
if [ "$(id -u)" -eq 0 ]; then
    echo 'Run PGPCrypt as your desktop user, without sudo.' >&2; exit 1
fi
case "${HOME:-}" in /*) ;; *) echo 'PGPCrypt needs an absolute HOME directory.' >&2; exit 1 ;; esac
for directory in "$HOME/.config" "$HOME/.local" "$HOME/.cache"; do
    if [ -L "$directory" ] || { [ -e "$directory" ] && [ ! -d "$directory" ]; }; then
        echo 'PGPCrypt cannot mask a symlink or non-directory at an XDG home location.' >&2; exit 1
    fi
done
if [ ! -x /usr/bin/bwrap ]; then
    echo 'Bubblewrap is required. Install with: sudo apt install bubblewrap' >&2; exit 1
fi
set -- /usr/bin/bwrap --die-with-parent --new-session --unshare-user --unshare-net \
    --unshare-pid --unshare-ipc --unshare-uts --cap-drop ALL \
    --bind / / --chdir "$HOME" --proc /proc --dev /dev --tmpfs /tmp \
    --tmpfs "$HOME/.config" --tmpfs "$HOME/.local" --tmpfs "$HOME/.cache" \
    --setenv XDG_CONFIG_HOME "$HOME/.config" --setenv XDG_DATA_HOME "$HOME/.local/share" \
    --setenv XDG_STATE_HOME "$HOME/.local/state" --setenv XDG_CACHE_HOME "$HOME/.cache" \
    --setenv PGPCRYPT_SANDBOX 1 --setenv QT_X11_NO_MITSHM 1 --setenv QT_QPA_PLATFORMTHEME '' \
    --setenv QT_USE_PORTAL 0 --setenv GTK_USE_PORTAL 0 --setenv GIO_USE_VFS local \
    --setenv DBUS_SESSION_BUS_ADDRESS unix:path=/tmp/pgpcrypt-no-session-bus \
    --setenv DBUS_SYSTEM_BUS_ADDRESS unix:path=/tmp/pgpcrypt-no-system-bus
# Display transport remains available. The network namespace blocks IP and
# abstract sockets; X11's filesystem socket must be explicitly made available.
if [ -d /tmp/.X11-unix ]; then set -- "$@" --ro-bind /tmp/.X11-unix /tmp/.X11-unix; fi
pgpcrypt_xauth=${XAUTHORITY:-$HOME/.Xauthority}
if [ -f "$pgpcrypt_xauth" ]; then
    set -- "$@" --ro-bind "$pgpcrypt_xauth" /tmp/pgpcrypt-Xauthority --setenv XAUTHORITY /tmp/pgpcrypt-Xauthority
fi
if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -S "$XDG_RUNTIME_DIR/bus" ]; then
    set -- "$@" --ro-bind /dev/null "$XDG_RUNTIME_DIR/bus"
fi
if [ -S /run/dbus/system_bus_socket ]; then set -- "$@" --ro-bind /dev/null /run/dbus/system_bus_socket; fi
# Do not silently fall back when this host disables unprivileged namespaces.
exec "$@" -- /usr/lib/pgpcrypt/pgpcrypt-desktop
